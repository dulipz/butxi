---
import Icon from './Icon.astro';
import { LANGS, LANG_META, path, alternates, type Lang } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  /** Transparent über einem Fullscreen-Hero; wird beim Scrollen fest (creme). */
  transparent?: boolean;
  lang?: Lang;
}
const { transparent = false, lang = 'de' } = Astro.props;
const T = t(lang);

const links = [
  { label: T.nav.home, href: path('home', lang) },
  { label: T.nav.shop, href: path('shop', lang) },
  { label: T.nav.about, href: path('about', lang) },
  { label: T.nav.production, href: path('production', lang) },
  { label: T.nav.recipes, href: path('recipes', lang) },
  { label: T.nav.contact, href: path('contact', lang) },
];
const pathname = Astro.url.pathname;
const home = path('home', lang);
const isActive = (href: string) =>
  href === home ? pathname === home || pathname === home.replace(/\/$/, '') : pathname.startsWith(href.replace(/\/$/, ''));
// Sprachumschalter: dieselbe Seite in der jeweils anderen Sprache
const alt = alternates(pathname);
---
<header class:list={['site-header', { 'site-header--transparent': transparent }]} data-header>
  <div class="site-header__inner container">
    <button class="site-header__burger" data-menu-toggle aria-label={T.header.menuOpen} aria-expanded="false">
      <Icon name="menu" size={22} />
    </button>
    <a href={home} class="site-header__logo" aria-label={T.header.homeAria}>
      <img src="/images/brand/butxi-logo-black.png" alt="BUTXI Gourmet" width="132" height="44" />
    </a>
    <nav class="site-header__nav" aria-label={T.header.mainNav}>
      {links.map((l) => (
        <a href={l.href} class:list={['site-header__link', { 'is-active': isActive(l.href) }]}>{l.label}</a>
      ))}
    </nav>
    <div class="site-header__actions">
      <!-- Sprachumschalter Desktop: DE · EN · ES -->
      <nav class="langswitch" aria-label={T.header.lang}>
        {LANGS.map((l) => (
          <a
            href={alt[l]}
            hreflang={LANG_META[l].htmlLang}
            lang={LANG_META[l].htmlLang}
            title={LANG_META[l].name}
            class:list={['langswitch__opt', { 'is-active': l === lang }]}
            aria-current={l === lang ? 'true' : undefined}
            data-lang-link={l}
          >{LANG_META[l].label}</a>
        ))}
      </nav>
      <!-- Sprachumschalter Mobil: kompaktes Dropdown -->
      <details class="langmenu" data-langmenu>
        <summary class="langmenu__btn" aria-label={T.header.lang}>
          {LANG_META[lang].label}<Icon name="chevron-down" size={14} />
        </summary>
        <div class="langmenu__list">
          {LANGS.map((l) => (
            <a
              href={alt[l]}
              hreflang={LANG_META[l].htmlLang}
              lang={LANG_META[l].htmlLang}
              class:list={['langmenu__opt', { 'is-active': l === lang }]}
              aria-current={l === lang ? 'true' : undefined}
              data-lang-link={l}
            ><strong>{LANG_META[l].label}</strong> {LANG_META[l].name}</a>
          ))}
        </div>
      </details>
      <a class="site-header__iconbtn" href={path('cart', lang)} aria-label={T.header.cartAria}>
        <Icon name="bag" size={21} />
        <span class="site-header__count" data-cart-count hidden>0</span>
      </a>
    </div>
  </div>

  <nav class="mobile-nav" data-mobile-nav aria-label={T.header.mobileNav} hidden>
    {links.map((l) => (
      <a href={l.href} class:list={['mobile-nav__link', { 'is-active': isActive(l.href) }]}>{l.label}</a>
    ))}
  </nav>
</header>

<!-- Promo-Banner: kommt von rechts unten herein, abonnieren oder schließen -->
<aside class="promo-toast" data-promo hidden aria-label={T.promo.aria}>
  <button class="promo-toast__close" data-promo-close aria-label={T.promo.close}>
    <Icon name="x" size={16} />
  </button>
  <p class="promo-toast__title">{T.promo.title}</p>
  <p class="promo-toast__text">{T.promo.text}</p>
  <form class="promo-toast__form" data-promo-form>
    <label class="visually-hidden" for="promo-email">{T.promo.emailLabel}</label>
    <input class="input" id="promo-email" type="email" name="email" placeholder={T.promo.placeholder} required />
    <button class="btn btn--primary" type="submit">{T.promo.submit}</button>
  </form>
  <p class="promo-toast__success" data-promo-success hidden>
    {T.promo.success}
  </p>
</aside>

<style>
  /* ---- Promo-Banner (rechts unten) ---- */
  .promo-toast {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: calc(var(--z-sticky) + 1);
    width: min(360px, calc(100vw - 40px));
    padding: 20px 20px 18px;
    background: var(--color-background-primary);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    transform: translateX(calc(100% + 40px));
    transition: transform 0.45s var(--ease-standard);
  }
  .promo-toast.is-visible { transform: translateX(0); }
  .promo-toast__close {
    position: absolute; top: 10px; right: 10px;
    display: grid; place-items: center;
    width: 32px; height: 32px;
    border: none; background: transparent; cursor: pointer;
    color: var(--color-text-muted); border-radius: 99px;
  }
  .promo-toast__close:hover { background: var(--color-neutral-100); color: var(--color-text-primary); }
  .promo-toast__title {
    margin: 0 24px 6px 0;
    font-family: var(--font-display);
    font-size: 19px; font-weight: 800;
  }
  .promo-toast__text { margin: 0 0 14px; font-size: 14px; line-height: 1.55; color: var(--color-text-secondary); }
  .promo-toast__form { display: flex; gap: 8px; }
  .promo-toast__form .input { flex: 1; min-width: 0; }
  .promo-toast__success { margin: 0; font-weight: 700; font-size: 14px; color: var(--color-success, #2e7d32); }
  @media (max-width: 479px) { .promo-toast__form { flex-direction: column; } }

  .site-header {
    position: sticky; top: 0; z-index: var(--z-sticky);
    background: rgba(247, 242, 232, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-default);
  }
  .site-header__inner { display: flex; align-items: center; gap: 28px; height: 76px; }
  .site-header__logo { flex: none; display: flex; }
  .site-header__logo img { height: 54px; width: auto; } /* größer, "HOTSAUCE & SPICES" besser lesbar */
  /* Startseite: Logo mittig über dem Hero-Badge "Aus Eigenanbau · Mallorca" */
  @media (min-width: 1024px) {
    .site-header--transparent .site-header__logo { margin-left: 66px; }
  }
  .site-header__nav { display: flex; gap: 22px; flex: 1; justify-content: center; }
  .site-header__link {
    font-size: 15px; font-weight: 600; color: var(--color-text-primary);
    padding: 6px 2px; border-bottom: 2px solid transparent;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .site-header__link:hover { color: var(--color-action-primary); }
  .site-header__link.is-active {
    font-weight: 800; color: var(--color-action-primary);
    border-bottom-color: var(--color-action-primary);
  }
  .site-header__actions { display: flex; gap: 8px; flex: none; margin-left: auto; }
  .site-header__iconbtn, .site-header__burger {
    position: relative; display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: var(--radius-pill);
    border: none; background: transparent; color: var(--color-text-primary); cursor: pointer;
    transition: background var(--duration-fast) var(--ease-standard);
  }
  .site-header__iconbtn:hover, .site-header__burger:hover { background: var(--color-neutral-100); }
  .site-header__count {
    position: absolute; top: 2px; right: 0;
    min-width: 18px; height: 18px; padding: 0 5px;
    display: grid; place-items: center;
    background: var(--color-action-primary); color: var(--color-text-inverse);
    font-size: 11px; font-weight: 800; border-radius: 99px;
  }
  .site-header__burger { display: none; }

  /* ---- Sprachumschalter ---- */
  .site-header__actions { align-items: center; }
  .langswitch {
    display: flex; align-items: center; gap: 2px;
    padding: 3px; margin-right: 4px;
    border: 1px solid var(--color-border-default); border-radius: var(--radius-pill);
  }
  .langswitch__opt {
    min-width: 34px; padding: 5px 8px; border-radius: var(--radius-pill);
    font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-align: center;
    color: var(--color-text-secondary);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }
  .langswitch__opt:hover { color: var(--color-text-primary); background: var(--color-neutral-100); }
  .langswitch__opt.is-active { background: var(--color-neutral-950); color: var(--color-text-inverse); }

  .langmenu { display: none; position: relative; }
  .langmenu__btn {
    display: flex; align-items: center; gap: 2px; height: 42px; padding: 0 8px;
    list-style: none; cursor: pointer; border-radius: var(--radius-pill);
    font-size: 13px; font-weight: 800; letter-spacing: 0.06em; color: var(--color-text-primary);
  }
  .langmenu__btn::-webkit-details-marker { display: none; }
  .langmenu[open] .langmenu__btn { background: var(--color-neutral-100); }
  .langmenu__list {
    position: absolute; right: 0; top: calc(100% + 6px); z-index: 5;
    min-width: 168px; padding: 6px;
    display: flex; flex-direction: column;
    background: var(--color-background-primary);
    border: 1px solid var(--color-border-default); border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px rgba(23, 19, 16, 0.16);
  }
  .langmenu__opt {
    display: flex; gap: 10px; padding: 10px 12px; border-radius: var(--radius-md);
    font-size: 15px; color: var(--color-text-primary);
  }
  .langmenu__opt strong { min-width: 24px; font-size: 12.5px; letter-spacing: 0.06em; padding-top: 2px; }
  .langmenu__opt:hover { background: var(--color-neutral-100); }
  .langmenu__opt.is-active { color: var(--color-action-primary); font-weight: 700; }

  /* ---- Transparente Variante (über Fullscreen-Hero) ---- */
  .site-header--transparent:not(.is-scrolled) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .site-header--transparent:not(.is-scrolled) .site-header__link,
  .site-header--transparent:not(.is-scrolled) .site-header__iconbtn,
  .site-header--transparent:not(.is-scrolled) .site-header__burger {
    color: #fff;
  }
  .site-header--transparent:not(.is-scrolled) .site-header__link:hover { color: rgba(255, 255, 255, 0.75); }
  .site-header--transparent:not(.is-scrolled) .site-header__link.is-active {
    color: #fff;
    border-bottom-color: #fff;
  }
  .site-header--transparent:not(.is-scrolled) .site-header__iconbtn:hover,
  .site-header--transparent:not(.is-scrolled) .site-header__burger:hover {
    background: rgba(255, 255, 255, 0.15);
  }
  .site-header--transparent:not(.is-scrolled) .langswitch { border-color: rgba(255, 255, 255, 0.45); }
  .site-header--transparent:not(.is-scrolled) .langswitch__opt { color: rgba(255, 255, 255, 0.85); }
  .site-header--transparent:not(.is-scrolled) .langswitch__opt:hover { color: #fff; background: rgba(255, 255, 255, 0.15); }
  .site-header--transparent:not(.is-scrolled) .langswitch__opt.is-active { background: #fff; color: var(--color-neutral-950); }
  .site-header--transparent:not(.is-scrolled) .langmenu__btn { color: #fff; }
  .site-header--transparent:not(.is-scrolled) .langmenu[open] .langmenu__btn { background: rgba(255, 255, 255, 0.15); }
  .site-header--transparent:not(.is-scrolled) .site-header__logo img {
    filter: brightness(0) invert(1); /* schwarzes Logo -> weiß */
  }
  .site-header--transparent {
    transition:
      background var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .mobile-nav {
    display: none; flex-direction: column; padding: 8px 16px 16px;
    border-top: 1px solid var(--color-border-default);
    background: var(--color-background-primary);
  }
  .mobile-nav__link {
    padding: 12px 8px; font-size: 16px; font-weight: 700;
    border-bottom: 1px solid var(--color-neutral-100);
  }
  .mobile-nav__link.is-active { color: var(--color-action-primary); }
  .mobile-nav.is-open { display: flex; }

  @media (max-width: 1023px) {
    .site-header__nav { display: none; }
    .site-header__burger { display: grid; }
    .site-header__inner { gap: 12px; }
    .site-header__logo { position: absolute; left: 50%; transform: translateX(-50%); }
    .site-header__inner { position: relative; }
    .site-header__actions { gap: 0; }
    .langswitch { display: none; }
    .langmenu { display: block; }
  }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('[data-mobile-nav]');
  const header = document.querySelector('[data-header]');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    if (nav) nav.hidden = !open;
    toggle.setAttribute('aria-expanded', String(!!open));
    // Offenes Mobilmenü braucht einen festen Hintergrund
    header?.classList.toggle('is-menu-open', !!open);
    if (open) header?.classList.add('is-scrolled');
    else onScroll();
  });

  // Transparenter Header: beim Scrollen fest werden
  const onScroll = () => {
    if (header?.classList.contains('is-menu-open')) return;
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  };
  if (header?.classList.contains('site-header--transparent')) {
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Mobiles Sprach-Dropdown bei Klick daneben schließen
  const langmenu = document.querySelector('[data-langmenu]') as HTMLDetailsElement | null;
  document.addEventListener('click', (e) => {
    if (langmenu?.open && !langmenu.contains(e.target as Node)) langmenu.open = false;
  });

  // ---- Promo-Banner: nach kurzer Zeit von rechts einblenden ----
  // Erst NACH der Cookie-Entscheidung, damit nicht zwei Banner konkurrieren.
  const promo = document.querySelector('[data-promo]') as HTMLElement | null;
  const PROMO_KEY = 'butxi-promo-dismissed';
  if (promo && !localStorage.getItem(PROMO_KEY)) {
    const startPromo = () => {
      promo.hidden = false;
      setTimeout(() => promo.classList.add('is-visible'), 1500);
    };
    if (localStorage.getItem('butxi-consent')) startPromo();
    else document.addEventListener('butxi:consent', startPromo, { once: true });

    const dismiss = () => {
      promo.classList.remove('is-visible');
      localStorage.setItem(PROMO_KEY, '1');
      setTimeout(() => { promo.hidden = true; }, 500);
    };
    promo.querySelector('[data-promo-close]')?.addEventListener('click', dismiss);
    promo.querySelector('[data-promo-form]')?.addEventListener('submit', (e) => {
      e.preventDefault();
      // TODO: An Newsletter-Dienst anbinden (z. B. Mailchimp/Brevo API-Endpunkt)
      const form = e.currentTarget as HTMLElement;
      form.hidden = true;
      const success = promo.querySelector('[data-promo-success]') as HTMLElement | null;
      if (success) success.hidden = false;
      localStorage.setItem(PROMO_KEY, '1');
      setTimeout(() => {
        promo.classList.remove('is-visible');
        setTimeout(() => { promo.hidden = true; }, 500);
      }, 3500);
    });
  }
</script>
