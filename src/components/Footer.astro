---
import { path, type Lang } from '../i18n/config';
import { t } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'de' } = Astro.props;
const T = t(lang);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__grid container">
    <div class="footer__brand">
      <img src="/images/brand/butxi-logo-black.png" alt="BUTXI Gourmet" width="156" height="52" />
      <p>{T.footer.tagline}</p>
    </div>
    <div class="footer__col">
      <h4>{T.footer.shop}</h4>
      <a href={path('shop', lang)}>{T.footer.allProducts}</a>
      <a href={path('recipes', lang)}>{T.nav.recipes}</a>
      <a href={path('about', lang)}>{T.nav.about}</a>
      <a href={path('production', lang)}>{T.nav.production}</a>
    </div>
    <div class="footer__col">
      <h4>{T.footer.legal}</h4>
      <a href={path('imprint', lang)}>{T.footer.imprint}</a>
      <a href={path('privacy', lang)}>{T.footer.privacy}</a>
      <a href={path('terms', lang)}>{T.footer.terms}</a>
      <a href={path('withdrawal', lang)}>{T.footer.withdrawal}</a>
      <a href={path('shipping', lang)}>{T.footer.shipping}</a>
      <a href="#" data-cookie-settings>{T.footer.cookies}</a>
    </div>
    <div class="footer__col">
      <h4>{T.footer.contact}</h4>
      <a href="tel:+4933413088288">{lang === 'de' ? '03341 / 3088288' : '+49 3341 3088288'}</a>
      <a href="mailto:info@butxigourmet.com">info@butxigourmet.com</a>
      <div class="footer__social">
        <a href="https://www.instagram.com/butxigourmet" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.facebook.com/butxigourmet" target="_blank" rel="noopener">Facebook</a>
        <a href="https://www.youtube.com/@butxigourmet" target="_blank" rel="noopener">YouTube</a>
      </div>
    </div>
  </div>
  <div class="footer__bar">
    <p>© {year} Butxi Gourmet · BMK Brühl macht Küche GmbH. {T.footer.rights}</p>
    <p class="footer__credit">{T.footer.developedBy} <a href="https://codestadt.de" target="_blank" rel="noopener">CodeStadt Digital GmbH</a></p>
  </div>
</footer>

<style>
  .footer { background: var(--color-background-dark); color: var(--color-text-inverse); }
  .footer__grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px;
    padding-top: 64px; padding-bottom: 40px;
  }
  .footer__brand { display: flex; flex-direction: column; gap: 16px; }
  .footer__brand img { height: 52px; width: auto; align-self: flex-start; filter: invert(1); }
  .footer__brand p {
    margin: 0; font-size: 14px; line-height: 1.6;
    color: var(--color-text-inverse-secondary); max-width: 300px;
  }
  .footer__col { display: flex; flex-direction: column; gap: 8px; }
  .footer__col h4 {
    font-family: var(--font-sans); font-size: 13px; font-weight: 800;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-text-inverse); margin: 0 0 6px;
  }
  .footer__col a {
    color: var(--color-text-inverse-secondary); font-size: 14px;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .footer__col a:hover { color: var(--color-text-inverse); }
  .footer__social { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
  .footer__bar {
    border-top: 1px solid var(--color-border-inverse);
    text-align: center; font-size: 13px; color: var(--color-text-inverse-secondary);
  }
  .footer__bar p { margin: 0; padding: 18px 32px; }
  .footer__bar .footer__credit { padding-top: 0; margin-top: -10px; font-size: 12.5px; }
  .footer__credit a { color: var(--color-text-inverse-secondary); text-decoration: underline; text-underline-offset: 2px; }
  .footer__credit a:hover { color: var(--color-text-inverse); }

  @media (max-width: 1023px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 639px)  { .footer__grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
