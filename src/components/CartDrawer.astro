---
import Icon from './Icon.astro';
const snipcartKey = import.meta.env.PUBLIC_SNIPCART_API_KEY ?? '';
---
<div class="cart" data-cart aria-hidden="true">
  <div class="cart__scrim" data-cart-close></div>
  <aside class="cart__panel" role="dialog" aria-modal="true" aria-label="Warenkorb">
    <div class="cart__head">
      <h2>Warenkorb <span data-cart-title-count></span></h2>
      <button class="cart__close" data-cart-close aria-label="Warenkorb schließen">
        <Icon name="x" size={20} />
      </button>
    </div>

    <div class="cart__shipping">
      <p data-shipping-label>Kostenloser Versand ab 39 €</p>
      <div class="cart__shipbar"><span data-shipping-bar></span></div>
    </div>

    <div class="cart__items" data-cart-items>
      <p class="cart__empty">Dein Warenkorb ist noch leer. Zeit für ein bisschen Gefahr.</p>
    </div>

    <div class="cart__foot">
      <div class="cart__subtotal">
        <span>Zwischensumme</span>
        <strong data-cart-subtotal>0,00 €</strong>
      </div>
      <button class="btn btn--primary btn--lg btn--full" data-checkout data-snipcart-key={snipcartKey} disabled>
        Zur Kasse
      </button>
      <p class="cart__note" data-checkout-note>inkl. MwSt., zzgl. Versand</p>
    </div>
  </aside>
</div>

<template data-cart-line-template>
  <div class="cart-line">
    <div class="cart-line__img"><img src="" alt="" /></div>
    <div class="cart-line__info">
      <p class="cart-line__name"></p>
      <p class="cart-line__meta"></p>
      <div class="cart-line__row">
        <div class="qty">
          <button class="qty__btn" data-qty-minus aria-label="Menge verringern">−</button>
          <span class="qty__value" data-qty-value>1</span>
          <button class="qty__btn" data-qty-plus aria-label="Menge erhöhen">+</button>
        </div>
        <strong class="cart-line__price"></strong>
      </div>
    </div>
    <button class="cart-line__remove" data-line-remove aria-label="Artikel entfernen">
      <Icon name="trash" size={16} />
    </button>
  </div>
</template>

<style>
  .cart { position: fixed; inset: 0; z-index: var(--z-drawer); pointer-events: none; }
  .cart__scrim {
    position: absolute; inset: 0; background: rgba(23, 19, 16, 0.5);
    opacity: 0; transition: opacity var(--duration-default) var(--ease-standard);
  }
  .cart__panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 420px; max-width: 92vw;
    background: var(--color-background-secondary);
    box-shadow: var(--shadow-lg);
    transform: translateX(105%);
    transition: transform var(--duration-slow) var(--ease-standard);
    display: flex; flex-direction: column;
  }
  .cart.is-open { pointer-events: auto; }
  .cart.is-open .cart__scrim { opacity: 1; }
  .cart.is-open .cart__panel { transform: none; }

  .cart__head {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 24px; border-bottom: 1px solid var(--color-border-default);
  }
  .cart__head h2 { font-size: 22px; }
  .cart__close {
    display: grid; place-items: center; width: 38px; height: 38px;
    border: none; border-radius: var(--radius-pill); background: transparent;
    color: var(--color-text-primary); cursor: pointer;
  }
  .cart__close:hover { background: var(--color-neutral-100); }

  .cart__shipping { padding: 16px 24px 0; }
  .cart__shipping p { margin: 0 0 8px; font-size: 13.5px; font-weight: 600; color: var(--color-text-secondary); }
  .cart__shipbar { height: 6px; border-radius: 99px; background: var(--color-neutral-100); overflow: hidden; }
  .cart__shipbar span {
    display: block; height: 100%; width: 0; border-radius: 99px;
    background: var(--color-olive-green);
    transition: width var(--duration-slow) var(--ease-standard);
  }

  .cart__items { flex: 1; overflow-y: auto; padding: 4px 24px; }
  .cart__empty { color: var(--color-text-secondary); padding: 32px 0; }

  .cart__foot {
    padding: 18px 24px 24px; border-top: 1px solid var(--color-border-default);
    display: flex; flex-direction: column; gap: 12px;
  }
  .cart__subtotal { display: flex; justify-content: space-between; font-size: 16px; }
  .cart__subtotal span { font-weight: 600; }
  .cart__note { margin: 0; font-size: 12.5px; color: var(--color-text-muted); text-align: center; }

  /* Cart lines (injected via template) */
  .cart :global(.cart-line) {
    display: flex; gap: 14px; align-items: flex-start;
    padding: 16px 0; border-bottom: 1px solid var(--color-neutral-100);
  }
  .cart :global(.cart-line__img) {
    width: 64px; height: 64px; flex: none; border-radius: var(--radius-md);
    background: var(--color-soft-cream); overflow: hidden;
  }
  .cart :global(.cart-line__img img) { width: 100%; height: 100%; object-fit: contain; padding: 6px; }
  .cart :global(.cart-line__info) { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .cart :global(.cart-line__name) { margin: 0; font-weight: 700; font-size: 14.5px; }
  .cart :global(.cart-line__meta) { margin: 0; font-size: 12.5px; color: var(--color-text-muted); }
  .cart :global(.cart-line__row) {
    display: flex; justify-content: space-between; align-items: center; margin-top: 8px;
  }
  .cart :global(.qty) {
    display: inline-flex; align-items: center; gap: 2px;
    border: 1px solid var(--color-border-default); border-radius: var(--radius-pill);
  }
  .cart :global(.qty__btn) {
    width: 28px; height: 28px; border: none; background: transparent;
    font-size: 15px; font-weight: 700; cursor: pointer; color: var(--color-text-primary);
    border-radius: 99px;
  }
  .cart :global(.qty__btn:hover) { background: var(--color-neutral-100); }
  .cart :global(.qty__value) { min-width: 22px; text-align: center; font-weight: 700; font-size: 14px; }
  .cart :global(.cart-line__price) { font-size: 14.5px; }
  .cart :global(.cart-line__remove) {
    border: none; background: transparent; color: var(--color-text-muted);
    cursor: pointer; padding: 6px; border-radius: 99px;
  }
  .cart :global(.cart-line__remove:hover) { color: var(--color-error); background: var(--color-neutral-100); }
</style>
