---
// Cookie-Hinweis im BUTXI-Look. Die Einwilligung wird in localStorage
// (butxi-consent) gespeichert und als Event 'butxi:consent' gemeldet.
// Tracking (GA4 / Meta Pixel) lädt NUR, wenn (a) unten eine ID konfiguriert
// ist und (b) der Besucher „Alle akzeptieren" gewählt hat. IDs kommen aus
// den env vars PUBLIC_GA4_ID / PUBLIC_META_PIXEL_ID (Cloudflare + .env);
// ohne IDs bleibt die Seite komplett tracking-frei.
const GA4 = import.meta.env.PUBLIC_GA4_ID ?? '';
const PIXEL = import.meta.env.PUBLIC_META_PIXEL_ID ?? '';
const hasTracking = Boolean(GA4 || PIXEL);
import { path, type Lang } from '../i18n/config';
import { t } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'de' } = Astro.props;
const T = t(lang).cookie;
const privacyHref = path('privacy', lang);
---
<aside class="cookiebar" data-cookiebar data-ga4={GA4} data-pixel={PIXEL} hidden aria-label={T.aria}>
  <div class="cookiebar__card" role="dialog" aria-modal="false" aria-labelledby="cookiebar-title">
    <p class="cookiebar__title" id="cookiebar-title">{T.title}</p>
    <p class="cookiebar__text">
      {hasTracking ? T.tracking : T.noTracking}&#32;<a href={privacyHref}>{T.privacyLink}</a>.
    </p>
    <div class="cookiebar__actions">
      <button type="button" class="btn btn--primary" data-cookie-accept-all>{T.acceptAll}</button>
      <button type="button" class="btn btn--secondary" data-cookie-necessary>{T.necessary}</button>
    </div>
  </div>
</aside>

<style>
  .cookiebar {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: calc(var(--z-modal) + 20); /* über Promo-Toast und Drawer */
    width: min(400px, calc(100vw - 40px));
  }
  .cookiebar[hidden] { display: none !important; }
  .cookiebar__card {
    background: var(--color-background-primary);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    box-shadow: 0 14px 44px rgba(23, 19, 16, 0.2);
    padding: 22px 22px 20px;
    transform: translateY(calc(100% + 40px));
    transition: transform 0.45s var(--ease-standard);
  }
  .cookiebar.is-visible .cookiebar__card { transform: none; }
  .cookiebar__title {
    margin: 0 0 8px;
    font-family: var(--font-accent);
    font-size: 22px;
    color: var(--color-text-primary);
  }
  .cookiebar__text {
    margin: 0 0 16px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .cookiebar__text a {
    color: var(--color-action-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cookiebar__actions { display: flex; gap: 10px; }
  .cookiebar__actions .btn { flex: 1; padding-inline: 10px; }
  @media (max-width: 479px) {
    .cookiebar { left: 12px; bottom: 12px; width: calc(100vw - 24px); }
    .cookiebar__actions { flex-direction: column; }
  }
</style>

<script>
  const KEY = 'butxi-consent';
  const bar = document.querySelector('[data-cookiebar]') as HTMLElement | null;

  const readConsent = (): { necessary: boolean; comfort: boolean } | null => {
    try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
  };
  const announce = () => document.dispatchEvent(new CustomEvent('butxi:consent'));

  const show = () => {
    if (!bar) return;
    bar.hidden = false;
    requestAnimationFrame(() => bar.classList.add('is-visible'));
  };
  const hide = () => {
    if (!bar) return;
    bar.classList.remove('is-visible');
    setTimeout(() => { bar.hidden = true; }, 500);
  };
  // ---- Tracking nur nach Einwilligung laden (IDs via env vars, s. Frontmatter) ----
  const cfg = { ga4: bar?.dataset.ga4 || '', pixel: bar?.dataset.pixel || '' };
  let trackingLoaded = false;
  const loadTracking = () => {
    if (trackingLoaded || (!cfg.ga4 && !cfg.pixel)) return;
    trackingLoaded = true;
    const w = window as any;
    if (cfg.ga4) {
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(cfg.ga4);
      document.head.appendChild(s);
      w.dataLayer = w.dataLayer || [];
      w.gtag = function () { w.dataLayer.push(arguments); };
      w.gtag('js', new Date());
      w.gtag('config', cfg.ga4, { anonymize_ip: true });
    }
    if (cfg.pixel) {
      if (!w.fbq) {
        const n: any = (w.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        });
        n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
        const t = document.createElement('script');
        t.async = true;
        t.src = 'https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(t);
      }
      w.fbq('init', cfg.pixel);
      w.fbq('track', 'PageView');
    }
  };

  const save = (comfort: boolean) => {
    const prev = readConsent();
    localStorage.setItem(KEY, JSON.stringify({ necessary: true, comfort, ts: Date.now() }));
    hide();
    announce();
    if (comfort) {
      loadTracking();
    } else if (prev?.comfort && trackingLoaded) {
      // Widerruf: bereits geladene Tracker durch Neuladen der Seite entfernen
      setTimeout(() => location.reload(), 400);
    }
  };

  bar?.querySelector('[data-cookie-accept-all]')?.addEventListener('click', () => save(true));
  bar?.querySelector('[data-cookie-necessary]')?.addEventListener('click', () => save(false));

  // Bei Rückkehr mit bestehender Einwilligung: Tracking direkt laden
  if (readConsent()?.comfort) loadTracking();

  // Footer-Link „Cookie-Einstellungen“: Banner erneut öffnen
  document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); show(); })
  );

  if (!readConsent()) {
    setTimeout(show, 800);
  }
</script>
