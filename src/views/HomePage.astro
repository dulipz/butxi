---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProductCard from '../components/ProductCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import Lightbox from '../components/Lightbox.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
import { recipes } from '../data/recipes';
import { path, type Lang } from '../i18n/config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = {
  de: {
    title: 'BUTXI Gourmet · Das Feuer Mallorcas',
    heroAlt: 'Das BUTXI Sortiment auf einem Holztisch in der Finca: Hot Sauces, Öle, Gewürzsalze und Sets vor einer Natursteinwand',
    badge: 'Aus Eigenanbau · Mallorca',
    h1: ['Mach jedes', 'Essen', 'zu Butxi'],
    leadFull: 'Das Feuer Mallorcas, in Öl, Chili und Charakter. Für alle, die Geschmack wollen…',
    leadFullStrong: 'und ein bisschen Gefahr.',
    leadShort: 'Das Feuer Mallorcas,', leadShortStrong: 'mit einem bisschen Gefahr.',
    ctaShop: 'Produkte entdecken', ctaMore: 'Mehr erfahren',
    giftAlt: 'TopGear Fußball', giftBadge: 'Geschenk',
    giftText: ['Bestell für über ', '100 €', ' und wir legen dir einen ', 'TopGear Fußball', ' gratis dazu.'],
    giftCta: 'Jetzt shoppen',
    classicsEyebrow: 'Unsere Klassiker', classicsTitle: 'Schärfe mit Handschrift', allProducts: 'Alle Produkte',
    legendEyebrow: 'Die Legende von BUTXI',
    legendQuote: '„Wenn Piratenschiffe am Horizont auftauchten, suchten sie keine Truhen, sie suchten den Geschmack, der Mut macht."',
    legendText: 'BUTXI war kein Gewürz. BUTXI war ein Versprechen. Ein Tropfen, und Mallorca steht in Flammen.',
    legendCta: 'Unsere Geschichte',
    valuesEyebrow: 'Natürlich. Bewusst. BUTXI.', valuesTitle: 'Vom Feld in die Flasche',
    values: [
      ['Verantwortung', 'Bewusster Anbau mit Fokus auf Umwelt und Qualität.'],
      ['Pflanzenkraft', 'Natürliche Prävention statt harter Eingriffe.'],
      ['Volles Aroma', 'Reife Zutaten aus Eigenanbau, für intensive Soßen & Salze.'],
    ],
    anbauAlts: ['Reife rote Chilis im BUTXI Eigenanbau', 'Chilipflanzen im Gewächshaus auf Mallorca', 'Violette Chilis am Strauch', 'Chilifeld auf Mallorca mit Blick zur Küste'],
    anbauEyebrow: 'Unser Anbau', anbauTitle: 'Geerntet nach Reife, nicht nach Kalender',
    anbauText: 'Bei BUTXI beginnt jede Hot Sauce im Eigenanbau: Wir ziehen ausgewählte Chilis, Kräuter und Zutaten selbst groß, damit Schärfe, Aroma und Qualität von Anfang an stimmen.',
    recipesEyebrow: 'Unsere Rezepte', recipesTitle: 'Gesund kochen, intensiver schmecken', allRecipes: 'Alle Rezepte',
  },
  en: {
    title: 'BUTXI Gourmet · The fire of Mallorca',
    heroAlt: 'The BUTXI range on a wooden table at the finca: hot sauces, oils, spiced salts and sets in front of a natural stone wall',
    badge: 'Home-grown · Mallorca',
    h1: ['Make every', 'meal', 'a Butxi'],
    leadFull: 'The fire of Mallorca, in oil, chilli and character. For everyone who wants flavour…',
    leadFullStrong: 'and a little danger.',
    leadShort: 'The fire of Mallorca,', leadShortStrong: 'with a little danger.',
    ctaShop: 'Discover the range', ctaMore: 'Learn more',
    giftAlt: 'TopGear football', giftBadge: 'Gift',
    giftText: ['Spend ', '€100', ' or more and we’ll add a ', 'TopGear football', ' for free.'],
    giftCta: 'Shop now',
    classicsEyebrow: 'Our classics', classicsTitle: 'Signature heat', allProducts: 'All products',
    legendEyebrow: 'The legend of BUTXI',
    legendQuote: '“When pirate ships appeared on the horizon, they weren’t looking for treasure chests. They were looking for the flavour that gives you courage.”',
    legendText: 'BUTXI was never just a spice. BUTXI was a promise. One drop, and Mallorca is ablaze.',
    legendCta: 'Our story',
    valuesEyebrow: 'Natural. Mindful. BUTXI.', valuesTitle: 'From field to bottle',
    values: [
      ['Responsibility', 'Mindful growing with a focus on the environment and quality.'],
      ['Plant power', 'Natural plant protection instead of harsh chemicals.'],
      ['Full flavour', 'Ripe, home-grown ingredients for intense sauces & salts.'],
    ],
    anbauAlts: ['Ripe red chillies in the BUTXI fields', 'Chilli plants in the greenhouse in Mallorca', 'Purple chillies on the plant', 'Chilli field in Mallorca overlooking the coast'],
    anbauEyebrow: 'Our fields', anbauTitle: 'Harvested when ripe, not by the calendar',
    anbauText: 'At BUTXI, every hot sauce starts in our own fields: we grow selected chillies, herbs and ingredients ourselves, so heat, aroma and quality are right from the very start.',
    recipesEyebrow: 'Our recipes', recipesTitle: 'Healthy cooking, bigger flavour', allRecipes: 'All recipes',
  },
  es: {
    title: 'BUTXI Gourmet · El fuego de Mallorca',
    heroAlt: 'La gama BUTXI sobre una mesa de madera en la finca: salsas picantes, aceites, sales aromatizadas y sets frente a un muro de piedra',
    badge: 'Cultivo propio · Mallorca',
    h1: ['Haz de cada', 'comida', 'un Butxi'],
    leadFull: 'El fuego de Mallorca, en aceite, chile y carácter. Para quien busca sabor…',
    leadFullStrong: 'y un poco de peligro.',
    leadShort: 'El fuego de Mallorca,', leadShortStrong: 'con un poco de peligro.',
    ctaShop: 'Descubre los productos', ctaMore: 'Saber más',
    giftAlt: 'Balón TopGear', giftBadge: 'Regalo',
    giftText: ['Con pedidos a partir de ', '100 €', ', te regalamos un ', 'balón TopGear', '.'],
    giftCta: 'Comprar ahora',
    classicsEyebrow: 'Nuestros clásicos', classicsTitle: 'Picante con sello propio', allProducts: 'Todos los productos',
    legendEyebrow: 'La leyenda de BUTXI',
    legendQuote: '«Cuando los barcos piratas aparecían en el horizonte, no buscaban cofres: buscaban el sabor que da valor.»',
    legendText: 'BUTXI no era una especia. BUTXI era una promesa. Una gota, y Mallorca arde.',
    legendCta: 'Nuestra historia',
    valuesEyebrow: 'Natural. Consciente. BUTXI.', valuesTitle: 'Del campo a la botella',
    values: [
      ['Responsabilidad', 'Cultivo consciente, centrado en el medio ambiente y la calidad.'],
      ['Fuerza vegetal', 'Protección natural de las plantas en lugar de tratamientos agresivos.'],
      ['Aroma pleno', 'Ingredientes maduros de cultivo propio, para salsas y sales intensas.'],
    ],
    anbauAlts: ['Chiles rojos maduros en el cultivo de BUTXI', 'Plantas de chile en el invernadero en Mallorca', 'Chiles morados en la planta', 'Campo de chiles en Mallorca con vistas a la costa'],
    anbauEyebrow: 'Nuestro cultivo', anbauTitle: 'Cosechado cuando madura, no según el calendario',
    anbauText: 'En BUTXI, cada salsa picante empieza en nuestro propio cultivo: cultivamos nosotros mismos chiles, hierbas e ingredientes seleccionados para que el picor, el aroma y la calidad estén a la altura desde el principio.',
    recipesEyebrow: 'Nuestras recetas', recipesTitle: 'Cocina sano, saborea más', allRecipes: 'Todas las recetas',
  },
}[lang];

const classics = ['fulla-d-olivera', 'habanero-orange', 'salsa-coenta', 'carolina-reaper']
  .map((s) => products.find((p) => p.slug === s)!);
const homeRecipes = recipes.filter((r) =>
  ['mais-limetten-salat', 'knoblauchbrot-butxi-picante'].includes(r.slug)
);
---
<BaseLayout title={T.title} lang={lang} transparentHeader>
  <!-- Hero -->
  <section class="hero">
    <picture>
      <source media="(max-width: 767px)" srcset="/images/hero/hero-mobile-001.webp" />
      <img
        class="hero__bg"
        src="/images/hero/hero-002.webp"
        alt={T.heroAlt}
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__content">
      <div class="hero__copy">
        <span class="badge badge--olive hero__badge-top">{T.badge}</span>
        <h1 class="hero__title display-xl">
          <span>{T.h1[0]}</span>
          <span class="hero__title-accent">{T.h1[1]}</span>
          <span>{T.h1[2]}</span>
        </h1>
      </div>
      <div class="hero__bottom">
        <p class="lead">
          <span class="hero__lead-full">{T.leadFull}
          <strong>{T.leadFullStrong}</strong></span>
          <span class="hero__lead-short">{T.leadShort} <strong>{T.leadShortStrong}</strong></span>
        </p>
        <div class="hero__actions">
          <a href={path('shop', lang)} class="btn btn--primary btn--lg">{T.ctaShop}</a>
          <a href={path('about', lang)} class="btn btn--inverse btn--lg">{T.ctaMore}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Geschenk-Banner: TopGear Fußball ab 100 € -->
  <section class="gift-banner-section">
    <div class="container">
      <div class="gift-banner reveal">
        <img class="gift-banner__img" src="/images/products/topgear-fussball-geschenk.webp" alt={T.giftAlt} loading="lazy" width="64" height="64" />
        <p class="gift-banner__text">
          <span class="badge badge--olive gift-banner__badge">{T.giftBadge}</span>
          {T.giftText[0]}<strong>{T.giftText[1]}</strong>{T.giftText[2]}<strong>{T.giftText[3]}</strong>{T.giftText[4]}
        </p>
        <a href={path('shop', lang)} class="btn btn--secondary btn--sm gift-banner__cta">{T.giftCta}</a>
      </div>
    </div>
  </section>

  <!-- Klassiker -->
  <section class="section">
    <div class="container">
      <div class="row-head reveal">
        <SectionHeader eyebrow={T.classicsEyebrow} title={T.classicsTitle} />
        <a href={path('shop', lang)} class="btn btn--ghost">{T.allProducts} <Icon name="arrow-right" size={17} /></a>
      </div>
      <div class="grid-4 classics" data-classics>
        {classics.map((p, i) => <ProductCard product={p} lang={lang} loading={i < 2 ? 'eager' : 'lazy'} />)}
      </div>
    </div>
  </section>

  <!-- Legende -->
  <section class="section--dark section--editorial legend-section">
    <video
      class="legend-section__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/videos/animation_landing_001.webm" type="video/webm" />
      <source src="/videos/animation_landing_001.mp4" type="video/mp4" />
    </video>
    <script>
      const legendVideo = document.querySelector<HTMLVideoElement>('.legend-section__video');
      if (legendVideo) {
        // Auf Mobilgeräten die Hochformat-Animation laden
        if (window.matchMedia('(max-width: 767px)').matches) {
          legendVideo.innerHTML =
            '<source src="/videos/animation_landing_mobile.webm" type="video/webm" />' +
            '<source src="/videos/animation_landing_mobile.mp4" type="video/mp4" />';
          legendVideo.load();
        }
        // Autoplay-Fallback (z. B. Safari Energiesparmodus): stumm abspielen erzwingen
        legendVideo.muted = true;
        legendVideo.play().catch(() => {});
      }
    </script>
    <div class="legend-section__overlay" aria-hidden="true"></div>
    <div class="container legend reveal">
      <span class="eyebrow">{T.legendEyebrow}</span>
      <p class="legend__quote">
        {T.legendQuote}
      </p>
      <p class="legend__text">
        {T.legendText}
      </p>
      <a href={path('about', lang)} class="btn btn--inverse">{T.legendCta}</a>
    </div>
  </section>

  <!-- Werte -->
  <section class="section">
    <div class="container">
      <SectionHeader align="center" eyebrow={T.valuesEyebrow} title={T.valuesTitle} />
      <div class="grid-3 features reveal">
        <div class="feature">
          <span class="feature__icon"><Icon name="clock" size={22} /></span>
          <h3>{T.values[0][0]}</h3>
          <p>{T.values[0][1]}</p>
        </div>
        <div class="feature">
          <span class="feature__icon"><Icon name="leaf" size={22} /></span>
          <h3>{T.values[1][0]}</h3>
          <p>{T.values[1][1]}</p>
        </div>
        <div class="feature">
          <span class="feature__icon"><Icon name="flame" size={22} /></span>
          <h3>{T.values[2][0]}</h3>
          <p>{T.values[2][1]}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Anbau -->
  <section class="section" style="padding-top: 0;">
    <div class="container anbau">
      <div class="anbau__imgs reveal">
        <img src="/images/anbau/anbau_chili_rot_001.webp" alt={T.anbauAlts[0]} loading="lazy" />
        <img src="/images/anbau/anbau_gewaechshaus_003.webp" alt={T.anbauAlts[1]} loading="lazy" class="anbau__img--offset" />
        <img src="/images/anbau/anbau_chili_lila_001.webp" alt={T.anbauAlts[2]} loading="lazy" />
        <img src="/images/anbau/anbau_feld_001.webp" alt={T.anbauAlts[3]} loading="lazy" class="anbau__img--offset" />
      </div>
      <div class="anbau__copy">
        <SectionHeader
          eyebrow={T.anbauEyebrow}
          title={T.anbauTitle}
          text={T.anbauText}
        />
        <a href={path('production', lang)} class="btn btn--secondary">{T.ctaMore}</a>
      </div>
    </div>
  </section>

  <!-- Rezepte -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="row-head reveal">
        <SectionHeader eyebrow={T.recipesEyebrow} title={T.recipesTitle} />
        <a href={path('recipes', lang)} class="btn btn--ghost">{T.allRecipes} <Icon name="arrow-right" size={17} /></a>
      </div>
      <div class="grid-2">
        {homeRecipes.map((r) => <RecipeCard recipe={r} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section--sand section">
    <div class="container">
      <NewsletterForm lang={lang} />
    </div>
  </section>
  <Lightbox lang={lang} />
</BaseLayout>

<style>
  /* Fullscreen-Hero: liegt unter dem transparenten Header (76px hochgezogen). */
  .hero {
    position: relative;
    margin-top: -77px; /* 76px Header + 1px Border, sonst blitzt oben eine weiße Linie auf */
    min-height: calc(100svh + 1px);
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero__overlay {
    position: absolute; inset: 0;
    background:
      /* unten kräftiger seit hero-002: das neue Motiv ist im Vordergrund hell (Holztisch, helle Etiketten) */
      linear-gradient(to bottom, rgba(20, 14, 8, 0.28) 0%, rgba(20, 14, 8, 0) 30%, rgba(20, 14, 8, 0.10) 58%, rgba(20, 14, 8, 0.62) 100%),
      linear-gradient(to right, rgba(20, 14, 8, 0.38) 0%, rgba(20, 14, 8, 0.10) 40%, rgba(20, 14, 8, 0) 65%);
  }
  .hero__content {
    position: relative; z-index: 1; width: 100%;
    display: flex; flex-direction: column; justify-content: space-between;
    padding-top: calc(76px + 36px);
    padding-bottom: 44px;
  }
  /* Hero-Badge etwas größer */
  .hero__copy .badge, .hero__bottom .badge { font-size: 19px; padding: 5px 18px; }

  /* Oben links: Badge + Headline (50 % kleiner), Zeilen mittig gestapelt */
  .hero__copy {
    display: flex; flex-direction: column; gap: 16px;
    align-items: center; width: fit-content;
  }
  .hero__title {
    display: flex; flex-direction: column; align-items: center;
    text-align: center; line-height: 1.08;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
    font-size: clamp(1.75rem, 3.5vw, 3.25rem); /* 50 % von display-xl */
  }
  .hero__title-accent {
    font-size: 1.3em; /* „Essen" etwas größer */
    color: var(--color-action-primary); /* Button-Rot */
  }
  /* Unten mittig: Text + Buttons */
  .hero__bottom {
    display: flex; flex-direction: column; gap: 20px;
    align-items: center; align-self: center; text-align: center;
    max-width: 640px;
  }
  .hero__bottom .lead {
    margin: 0; font-size: 19px; color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  }
  .hero__bottom .lead strong { color: #fff; }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

  /* Geschenk-Banner */
  .gift-banner-section { padding: 28px 0 0; }
  .gift-banner {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    background: var(--color-mallorca-sand);
    border-radius: var(--radius-xl);
    padding: 16px 26px;
  }
  .gift-banner__img {
    width: 56px; height: 56px; border-radius: 50%;
    object-fit: cover; object-position: 50% 42%;
    border: 2px solid var(--color-warm-white);
    flex-shrink: 0;
  }
  .gift-banner__text {
    margin: 0; flex: 1; min-width: 220px;
    font-size: 15px; line-height: 1.5; color: var(--color-deep-brown);
  }
  .gift-banner__badge { margin-right: 10px; vertical-align: middle; }
  .gift-banner__cta { flex-shrink: 0; }
  @media (max-width: 639px) {
    .gift-banner { padding: 18px 20px; }
    .gift-banner__cta { width: 100%; }
  }

  .row-head {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 36px; gap: 24px;
  }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }

  /* Legende: Video läuft stumm im Hintergrund */
  .legend-section { position: relative; overflow: hidden; }
  .legend-section__video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .legend-section__overlay {
    position: absolute; inset: 0;
    background: rgba(15, 12, 9, 0.55); /* Lesbarkeit über dem Video */
  }
  .legend-section .legend { position: relative; z-index: 1; }

  .legend {
    max-width: 720px; text-align: center;
    display: flex; flex-direction: column; gap: 24px; align-items: center;
  }
  .legend__quote {
    margin: 0; font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.35rem, 2.25vw, 1.95rem); /* 25 % kleiner */
    line-height: 1.25;
    color: var(--color-text-inverse); text-wrap: balance;
  }
  .legend__text {
    margin: 0; font-size: 16px; line-height: 1.7;
    color: var(--color-text-inverse-secondary); max-width: 560px;
  }

  .features { margin-top: 48px; }
  .feature { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .feature__icon {
    display: grid; place-items: center; width: 52px; height: 52px;
    border-radius: var(--radius-md); background: var(--color-mallorca-sand);
    color: var(--color-deep-brown); margin-bottom: 4px;
  }
  .feature p { margin: 0; color: var(--color-text-secondary); }

  .anbau { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .anbau__imgs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .anbau__imgs img {
    width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-xl);
  }
  .anbau__img--offset { margin-top: 32px; }
  .anbau__copy { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }

  .hero__lead-short { display: none; }

  /* ---- Mobile: Hero-Text mittig, Klassiker als 3D-Karussell, weniger Text ---- */
  @media (max-width: 767px) {
    /* Badge auf Mobil ausblenden; Headline etwas tiefer (Flaschendeckel frei) */
    .hero__copy .badge { display: none; }
    .hero__title { margin-top: 14px; }

    /* Hero: kurze Unterzeile statt drei Zeilen */
    .hero__lead-full { display: none; }
    .hero__lead-short { display: inline; }

    /* Legende: nur das Zitat, ohne Zusatzabsatz */
    .legend .legend__text { display: none; }

    /* Werte: nur Icon + Titel, kompakt in einer Reihe */
    .features { grid-template-columns: repeat(3, 1fr) !important; gap: 12px !important; margin-top: 28px; }
    .feature { align-items: center; text-align: center; gap: 6px; }
    .feature p { display: none; }
    .feature h3 { font-size: 14px; }
    .feature__icon { width: 44px; height: 44px; }

    /* Anbau: zwei Bilder statt vier, ohne Fließtext */
    .anbau__imgs img:nth-child(n+3) { display: none; }
    .anbau__copy :global(.section-header .lead) { display: none; }
    .hero__content { padding-top: calc(76px + 4px); } /* Text-Block höher */
    /* Headline-Block in die linke Ecke, Zeilen linksbündig */
    .hero__copy {
      align-self: flex-start;
      width: 100%;
      align-items: flex-start;
      text-align: left;
    }
    .hero__title { align-items: flex-start; text-align: left; font-size: clamp(1.7rem, 7.65vw, 2.21rem); } /* 15 % kleiner */

    .classics {
      display: flex;
      gap: 18px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      perspective: 1200px;
      /* Track = 100vw − 32px Container-Padding; Karte 74vw →
         Seitenabstand (26vw − 32px) / 2, damit jede Karte exakt mittig snappt */
      padding: 12px calc(13vw - 16px) 24px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .classics::-webkit-scrollbar { display: none; }
    .classics > :global(*) {
      flex: 0 0 74vw;
      scroll-snap-align: center;
      transform-style: preserve-3d;
      transition: transform 0.25s ease-out, opacity 0.25s ease-out;
      will-change: transform;
    }
    /* Preis + Button untereinander, damit nichts abgeschnitten wird */
    .classics :global(.product-card__row) { flex-direction: column; align-items: stretch; gap: 8px; }
    .classics :global(.product-card__row .btn) { width: 100%; }
  }

  @media (max-width: 1023px) {
    .hero__content { padding-bottom: 48px; }
    .grid-4 { grid-template-columns: 1fr 1fr; }
    .grid-3 { grid-template-columns: 1fr; gap: 28px; }
    .anbau { grid-template-columns: 1fr; }
  }
  @media (max-width: 639px) {
    .grid-4:not(.classics) { grid-template-columns: 1fr; }
    .grid-2 { grid-template-columns: 1fr; }
    .row-head { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>

<script>
  // Klassiker als 3D-Cover-Flow auf Mobilgeräten
  const track = document.querySelector<HTMLElement>('[data-classics]');
  if (track && window.matchMedia('(max-width: 767px)').matches) {
    const cards = Array.from(track.children) as HTMLElement[];
    const update = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      for (const card of cards) {
        const center = card.offsetLeft + card.offsetWidth / 2;
        const norm = Math.max(-1, Math.min(1, (center - mid) / track.clientWidth));
        card.style.transform =
          `rotateY(${(-norm * 28).toFixed(1)}deg) scale(${(1 - Math.abs(norm) * 0.14).toFixed(3)}) translateZ(${(-Math.abs(norm) * 60).toFixed(0)}px)`;
        card.style.opacity = String(1 - Math.abs(norm) * 0.35);
        card.style.zIndex = String(100 - Math.round(Math.abs(norm) * 50));
      }
    };
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', update);
    // Erste Karte beim Laden exakt zentrieren
    const first = cards[0];
    if (first) track.scrollLeft = first.offsetLeft - (track.clientWidth - first.offsetWidth) / 2;
    update();
  }
</script>
