---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { path, type Lang } from '../i18n/config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const icons = ['leaf', 'heart', 'clock', 'check'];
const T = {
  de: {
    title: 'Produktion · BUTXI Gourmet',
    desc: 'Handwerk, Zeit und Feuer: Wie BUTXI Hot Sauces und Gourmet-Salze im Eigenanbau und in der Manufaktur entstehen.',
    heroAlt: 'Die BUTXI Finca aus der Luft: Steinhäuser, Innenhof und Olivenhaine vor der Serra de Tramuntana',
    badge: 'Produktion · Eigenanbau', h1: ['Handwerk, Zeit und', 'Feuer'],
    leadFull: 'Wir kochen, fermentieren und verfeinern unsere Hot Sauce selbst, statt auf Massenware zu setzen.',
    leadShort: 'Selbst gekocht und fermentiert, keine Massenware.', cta: 'Unsere Prinzipien',
    eyebrow: 'Unsere Produktion', h2: 'Vier Prinzipien, eine Handschrift',
    principles: [
      ['Eigenanbau', 'Viele unserer Chilis und Kräuter bauen wir vor Ort selbst an, für maximale Frische, klare Herkunft und intensives Aroma in jeder Flasche.'],
      ['Manufaktur', 'Unsere Soßen entstehen in kleinen Chargen statt Massenproduktion, mit Handarbeit vom Schneiden bis zur Abfüllung.'],
      ['Zeit & Reife', 'Durch sorgfältige Verarbeitung und ausgewählte Reifeprozesse wie Fermentation entsteht Tiefe, Schärfe mit Charakter statt bloßem Brennen.'],
      ['Qualitätskontrolle', 'Kontrolle vom Feld bis zur Flasche: Rohstoffe, Geschmack, Schärfe und Konsistenz, jede Charge muss unseren Ansprüchen genügen.'],
    ],
    anbauAlt: 'Chilipflanzen im BUTXI Gewächshaus auf Mallorca', anbauEyebrow: 'Vom Feld in die Flasche',
    anbauH: 'Geerntet nach Reife, nicht nach Kalender',
    anbauP: 'Unsere Chilis wachsen, bis Reife, Aroma und Schärfe exakt unseren Ansprüchen entsprechen, erst dann wird geerntet. So stimmt die Qualität von Anfang an, lange bevor die erste Flasche gefüllt ist.',
    salzEyebrow: 'Salzproduktion', salzTitle: 'Das Finish, das man sieht und schmeckt',
    salzText: 'Mallorquinische Salzflocken, verarbeitet mit charakterstarken Blends aus eigenem Anbau, als Finish, das Gerichte sichtbar und schmeckbar aufwertet.',
    salzCta: 'Salze entdecken', salzAlt: 'BUTXI Produkte',
  },
  en: {
    title: 'Production · BUTXI Gourmet',
    desc: 'Craft, time and fire: how BUTXI hot sauces and gourmet salts are made, from our own fields to our small craft kitchen.',
    heroAlt: 'The BUTXI finca from above: stone houses, a courtyard and olive groves in front of the Serra de Tramuntana',
    badge: 'Production · Home-grown', h1: ['Craft, time and', 'fire'],
    leadFull: 'We cook, ferment and refine our hot sauce ourselves instead of relying on mass production.',
    leadShort: 'Cooked and fermented by us, never mass-produced.', cta: 'Our principles',
    eyebrow: 'Our production', h2: 'Four principles, one signature',
    principles: [
      ['Home-grown', 'We grow many of our chillies and herbs ourselves, on site, for maximum freshness, a clear origin and intense flavour in every bottle.'],
      ['Small-batch craft', 'Our sauces are made in small batches rather than mass production, by hand from chopping to bottling.'],
      ['Time & ripeness', 'Careful processing and selected ripening methods such as fermentation create depth: heat with character rather than mere burn.'],
      ['Quality control', 'Checked from field to bottle: raw ingredients, flavour, heat and consistency. Every batch has to meet our standards.'],
    ],
    anbauAlt: 'Chilli plants in the BUTXI greenhouse in Mallorca', anbauEyebrow: 'From field to bottle',
    anbauH: 'Harvested when ripe, not by the calendar',
    anbauP: 'Our chillies keep growing until their ripeness, aroma and heat are exactly right, and only then do we harvest. That way the quality is right from the start, long before the first bottle is filled.',
    salzEyebrow: 'Salt production', salzTitle: 'The finishing touch you can see and taste',
    salzText: 'Mallorcan salt flakes blended with characterful mixes from our own fields: a finishing touch that lifts dishes in looks and in flavour.',
    salzCta: 'Discover the salts', salzAlt: 'BUTXI products',
  },
  es: {
    title: 'Producción · BUTXI Gourmet',
    desc: 'Artesanía, tiempo y fuego: así nacen las salsas picantes y las sales gourmet de BUTXI, del cultivo propio al obrador.',
    heroAlt: 'La finca BUTXI desde el aire: casas de piedra, patio y olivares frente a la Serra de Tramuntana',
    badge: 'Producción · Cultivo propio', h1: ['Artesanía, tiempo y', 'fuego'],
    leadFull: 'Cocinamos, fermentamos y perfeccionamos nuestra salsa picante nosotros mismos, en lugar de apostar por la producción en masa.',
    leadShort: 'Cocinada y fermentada por nosotros, nada de producción en masa.', cta: 'Nuestros principios',
    eyebrow: 'Nuestra producción', h2: 'Cuatro principios, un mismo sello',
    principles: [
      ['Cultivo propio', 'Cultivamos nosotros mismos muchos de nuestros chiles y hierbas, para lograr la máxima frescura, un origen claro y un aroma intenso en cada botella.'],
      ['Obrador artesanal', 'Nuestras salsas se elaboran en pequeños lotes y no en producción masiva, a mano desde el corte hasta el embotellado.'],
      ['Tiempo y maduración', 'Un procesado cuidadoso y procesos de maduración seleccionados, como la fermentación, aportan profundidad: picante con carácter, no simple ardor.'],
      ['Control de calidad', 'Control del campo a la botella: materias primas, sabor, picor y consistencia. Cada lote tiene que cumplir nuestras exigencias.'],
    ],
    anbauAlt: 'Plantas de chile en el invernadero de BUTXI en Mallorca', anbauEyebrow: 'Del campo a la botella',
    anbauH: 'Cosechado cuando madura, no según el calendario',
    anbauP: 'Nuestros chiles crecen hasta que su madurez, su aroma y su picor son exactamente los que buscamos; solo entonces los cosechamos. Así garantizamos la calidad desde el principio, mucho antes de llenar la primera botella.',
    salzEyebrow: 'Producción de sal', salzTitle: 'El toque final que se ve y se saborea',
    salzText: 'Escamas de sal mallorquina combinadas con mezclas con carácter de nuestro propio cultivo: un toque final que realza los platos a la vista y en el paladar.',
    salzCta: 'Descubre las sales', salzAlt: 'Productos BUTXI',
  },
}[lang];
const principles = T.principles.map(([title, text], i) => ({ icon: icons[i], title, text }));
---
<BaseLayout title={T.title} description={T.desc} lang={lang} transparentHeader>
  <!-- Fullscreen-Hero, gleiche Mechanik wie auf der Startseite -->
  <section class="hero">
    <picture>
      <source media="(max-width: 767px)" srcset="/images/hero/hero-produktion-mobile-001.webp" />
      <img
        class="hero__bg"
        src="/images/hero/hero-produktion-001.webp"
        alt={T.heroAlt}
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__content">
      <div class="hero__copy">
        <span class="badge badge--olive hero__badge-top">{T.badge}</span>
        <h1 class="hero__title display-xl">
          <span>{T.h1[0]}</span>
          <span class="hero__title-accent">{T.h1[1]}</span>
        </h1>
      </div>
      <div class="hero__bottom">
        <p class="lead">
          <span class="hero__lead-full">{T.leadFull}</span>
          <span class="hero__lead-short">{T.leadShort}</span>
        </p>
        <div class="hero__actions">
          <a href="#prinzipien" class="btn btn--primary btn--lg">{T.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="prinzipien">
    <div class="container">
      <SectionHeader eyebrow={T.eyebrow} title={T.h2} />
      <div class="principles">
        {principles.map((p, i) => (
          <div class="principle card">
            <span class="principle__num">0{i + 1}</span>
            <span class="principle__icon"><Icon name={p.icon} size={22} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section--dark section">
    <div class="container anbau">
      <img src="/images/anbau/anbau_gewaechshaus_001.webp" alt={T.anbauAlt} loading="lazy" />
      <div class="anbau__copy">
        <span class="eyebrow">{T.anbauEyebrow}</span>
        <h2>{T.anbauH}</h2>
        <p>{T.anbauP}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container salz">
      <div class="salz__copy">
        <SectionHeader
          eyebrow={T.salzEyebrow}
          title={T.salzTitle}
          text={T.salzText}
        />
        <a href={path('shop', lang)} class="btn btn--secondary">{T.salzCta}</a>
      </div>
      <img src="/images/products/product_001.webp" alt={T.salzAlt} loading="lazy" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Fullscreen-Hero: liegt unter dem transparenten Header (76px hochgezogen). */
  .hero {
    position: relative;
    margin-top: -77px; /* 76px Header + 1px Border, sonst blitzt oben eine weiße Linie auf */
    min-height: calc(100svh + 1px);
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero__overlay {
    position: absolute; inset: 0;
    background:
      /* unten kräftiger als auf der Startseite: der Vordergrund dieses Motivs ist hell */
      linear-gradient(to bottom, rgba(20, 14, 8, 0.30) 0%, rgba(20, 14, 8, 0) 30%, rgba(20, 14, 8, 0.10) 58%, rgba(20, 14, 8, 0.62) 100%),
      linear-gradient(to right, rgba(20, 14, 8, 0.42) 0%, rgba(20, 14, 8, 0.12) 40%, rgba(20, 14, 8, 0) 65%);
  }
  .hero__content {
    position: relative; z-index: 1; width: 100%;
    display: flex; flex-direction: column; justify-content: space-between;
    padding-top: calc(76px + 36px);
    padding-bottom: 44px;
  }
  .hero__copy .badge, .hero__bottom .badge { font-size: 19px; padding: 5px 18px; }
  .hero__copy {
    display: flex; flex-direction: column; gap: 16px;
    align-items: center; width: fit-content;
  }
  .hero__title {
    display: flex; flex-direction: column; align-items: center;
    text-align: center; line-height: 1.08;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
    font-size: clamp(1.75rem, 3.5vw, 3.25rem);
  }
  .hero__title-accent {
    font-size: 1.3em;
    color: var(--color-action-primary);
  }
  .hero__bottom {
    display: flex; flex-direction: column; gap: 20px;
    align-items: center; align-self: center; text-align: center;
    max-width: 640px;
  }
  .hero__bottom .lead {
    margin: 0; font-size: 19px; color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .hero__lead-short { display: none; }

  @media (max-width: 767px) {
    .hero__copy .badge { display: none; }
    .hero__title { margin-top: 14px; }
    .hero__lead-full { display: none; }
    .hero__lead-short { display: inline; }
    .hero__content { padding-top: calc(76px + 4px); }
    .hero__copy {
      align-self: flex-start;
      width: 100%;
      align-items: flex-start;
      text-align: left;
    }
    .hero__title { align-items: flex-start; text-align: left; font-size: clamp(1.7rem, 7.65vw, 2.21rem); }
  }
  @media (max-width: 1023px) {
    .hero__content { padding-bottom: 48px; }
  }

  .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; }
  .principle { padding: 28px; display: flex; flex-direction: column; gap: 10px; position: relative; }
  .principle__num {
    position: absolute; top: 22px; right: 26px;
    font-family: var(--font-display); font-size: 28px; font-weight: 600;
    color: var(--color-neutral-200);
  }
  .principle__icon {
    display: grid; place-items: center; width: 48px; height: 48px;
    border-radius: var(--radius-md); background: var(--color-mallorca-sand);
    color: var(--color-deep-brown); margin-bottom: 4px;
  }
  .principle p { margin: 0; color: var(--color-text-secondary); }

  .anbau, .salz { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .anbau img, .salz img {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-xl);
  }
  .anbau__copy, .salz__copy { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .anbau__copy h2 { color: var(--color-text-inverse); }
  .anbau__copy p { margin: 0; color: var(--color-text-inverse-secondary); line-height: 1.75; }

  @media (max-width: 1023px) {
    .principles { grid-template-columns: 1fr; }
    .anbau, .salz { grid-template-columns: 1fr; }
    .salz img { order: -1; }
  }
</style>
