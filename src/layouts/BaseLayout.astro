---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Header liegt transparent über dem Seitenanfang (z. B. Fullscreen-Hero) und wird beim Scrollen fest. */
  transparentHeader?: boolean;
}
const {
  title,
  description = 'BUTXI Gourmet, Hot Sauces, Salze & Gewürze aus Eigenanbau, handgemacht auf Mallorca. Das Feuer Mallorcas für deine Küche.',
  transparentHeader = false,
} = Astro.props;
const snipcartKey = import.meta.env.PUBLIC_SNIPCART_API_KEY ?? '';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/brand/butxi-logo-black.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <Header transparent={transparentHeader} />
    <!-- Snipcart-Preisvalidierung für die KKAD-Spende (1-Cent-Einheit, Menge = Betrag in Cent) -->
    <button
      hidden
      aria-hidden="true"
      tabindex="-1"
      class="snipcart-add-item"
      data-item-id="spende-kkad"
      data-item-name="Spende an KKAD"
      data-item-price="0.01"
      data-item-url="/"
      data-item-shippable="false"
      data-item-taxable="false"
      data-item-max-quantity="100000"
    ></button>
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Feedback nach "In den Warenkorb" (der Warenkorb ist jetzt eine eigene Seite) -->
    <div class="added-toast" data-added-toast hidden role="status">
      <span class="added-toast__check">✓</span>
      <span class="added-toast__text"><strong data-added-name></strong> wurde in den Warenkorb gelegt.</span>
      <a class="btn btn--primary btn--sm" href="/warenkorb/">Warenkorb ansehen</a>
    </div>

    {snipcartKey && (
      <>
        <link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.4.1/default/snipcart.css" />
        <script async src="https://cdn.snipcart.com/themes/v3.4.1/default/snipcart.js"></script>
        <div hidden id="snipcart" data-api-key={snipcartKey} data-config-modal-style="side" data-currency="eur"></div>
        <script>
          // Snipcart-Checkout auf Deutsch umstellen (Übersetzungen aus dem offiziellen l10n-Repo)
          document.addEventListener('snipcart.ready', async () => {
            try {
              const res = await fetch('https://cdn.jsdelivr.net/gh/snipcart/snipcart-l10n@master/locales/de.json');
              const de = await res.json();
              (window as any).Snipcart.api.session.setLanguage('de', de);
            } catch (e) {
              console.warn('Snipcart-Übersetzung konnte nicht geladen werden', e);
            }
          });
        </script>
      </>
    )}

    <script>
      // ------------------------------------------------------------------
      // BUTXI Cart, lightweight local cart (localStorage) with Snipcart
      // hand-off at checkout when PUBLIC_SNIPCART_API_KEY is configured.
      // ------------------------------------------------------------------
      type CartItem = { id: string; name: string; price: number; image: string; meta: string; qty: number };
      type Donation = { mode: 'none' | 'pct' | 'custom'; pct?: number; amount?: number };
      const KEY = 'butxi-cart';
      const DON_KEY = 'butxi-donation';
      const FREE_SHIPPING = 39;

      const read = (): CartItem[] => {
        try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; }
      };
      const write = (items: CartItem[]) => localStorage.setItem(KEY, JSON.stringify(items));
      const fmt = (n: number) => n.toFixed(2).replace('.', ',') + ' €';

      // ---- Spende an KKAD ----
      const readDon = (): Donation => {
        try { return JSON.parse(localStorage.getItem(DON_KEY) || '{"mode":"none"}'); } catch { return { mode: 'none' }; }
      };
      const writeDon = (d: Donation) => localStorage.setItem(DON_KEY, JSON.stringify(d));
      const donationAmount = (subtotal: number): number => {
        const d = readDon();
        if (d.mode === 'pct' && d.pct) return Math.round(subtotal * d.pct) / 100;
        if (d.mode === 'custom' && d.amount) return Math.round(d.amount * 100) / 100;
        return 0;
      };

      const itemsEl = document.querySelector('[data-cart-items]') as HTMLElement | null;
      const tpl = document.querySelector('[data-cart-line-template]') as HTMLTemplateElement | null;

      function render() {
        const items = read();
        const count = items.reduce((n, i) => n + i.qty, 0);
        const subtotal = items.reduce((s, i) => s + i.price * i.qty, 0);

        // Header count
        document.querySelectorAll('[data-cart-count]').forEach((el) => {
          (el as HTMLElement).hidden = count === 0;
          el.textContent = String(count);
        });
        const titleCount = document.querySelector('[data-cart-title-count]');
        if (titleCount) titleCount.textContent = count ? `(${count})` : '';

        // Shipping progress
        const bar = document.querySelector('[data-shipping-bar]') as HTMLElement | null;
        const label = document.querySelector('[data-shipping-label]');
        if (bar) bar.style.width = Math.min(100, (subtotal / FREE_SHIPPING) * 100) + '%';
        if (label) {
          label.textContent = subtotal >= FREE_SHIPPING
            ? 'Kostenloser Versand, geschafft!'
            : `Noch ${fmt(FREE_SHIPPING - subtotal)} bis zum kostenlosen Versand`;
        }

        // Tabellenkopf der Warenkorb-Seite nur zeigen, wenn Artikel da sind
        document.querySelectorAll('[data-cart-head]').forEach((el) => {
          (el as HTMLElement).hidden = items.length === 0;
        });

        // Lines
        if (itemsEl && tpl) {
          itemsEl.innerHTML = '';
          if (items.length === 0) {
            itemsEl.innerHTML =
              '<div class="cart__empty"><p>Dein Warenkorb ist noch leer. Zeit für ein bisschen Gefahr.</p>' +
              '<a class="btn btn--primary" href="/shop/">Zum Shop</a></div>';
          } else {
            for (const it of items) {
              const node = tpl.content.cloneNode(true) as DocumentFragment;
              const img = node.querySelector('img')!;
              img.src = it.image; img.alt = it.name;
              node.querySelector('.cart-line__name')!.textContent = it.name;
              node.querySelector('.cart-line__meta')!.textContent = it.meta;
              node.querySelector('[data-qty-value]')!.textContent = String(it.qty);
              const unitEl = node.querySelector('[data-line-unit]');
              if (unitEl) unitEl.textContent = fmt(it.price);
              node.querySelector('.cart-line__price')!.textContent = fmt(it.price * it.qty);
              node.querySelector('[data-qty-plus]')!.addEventListener('click', () => changeQty(it.id, 1));
              node.querySelector('[data-qty-minus]')!.addEventListener('click', () => changeQty(it.id, -1));
              node.querySelector('[data-line-remove]')!.addEventListener('click', () => removeItem(it.id));
              itemsEl.appendChild(node);
            }
          }
        }

        // Subtotal + checkout button
        const subEl = document.querySelector('[data-cart-subtotal]');
        if (subEl) subEl.textContent = fmt(subtotal);
        const checkout = document.querySelector('[data-checkout]') as HTMLButtonElement | null;
        if (checkout) checkout.disabled = items.length === 0;

        // ---- Spende an KKAD: Vorschau-Beträge, Auswahl-Zustand, Summenzeilen ----
        const don = readDon();
        const donAmt = donationAmount(subtotal);
        const donBox = document.querySelector('[data-donation-box]') as HTMLElement | null;
        if (donBox) donBox.hidden = items.length === 0;
        document.querySelectorAll('[data-donate-preview]').forEach((el) => {
          const pct = Number((el as HTMLElement).dataset.donatePreview);
          el.textContent = fmt(Math.round(subtotal * pct) / 100);
        });
        document.querySelectorAll('[data-donate-pct]').forEach((btn) => {
          btn.classList.toggle('is-active', don.mode === 'pct' && Number((btn as HTMLElement).dataset.donatePct) === don.pct);
        });
        document.querySelector('[data-donate-none]')?.classList.toggle('is-active', don.mode === 'none');
        const donRow = document.querySelector('[data-donation-row]') as HTMLElement | null;
        const totalRow = document.querySelector('[data-total-row]') as HTMLElement | null;
        const showDon = donAmt > 0 && items.length > 0;
        if (donRow) donRow.hidden = !showDon;
        if (totalRow) totalRow.hidden = !showDon;
        const donAmtEl = document.querySelector('[data-donation-amount]');
        if (donAmtEl) donAmtEl.textContent = fmt(donAmt);
        const totalEl = document.querySelector('[data-cart-total]');
        if (totalEl) totalEl.textContent = fmt(subtotal + donAmt);

        // Spendenzeile am Ende der Artikelliste (Warenkorb-Seite)
        const donLine = document.querySelector('[data-donation-line]') as HTMLElement | null;
        if (donLine) {
          donLine.hidden = !showDon;
          const lbl = donLine.querySelector('[data-donation-line-label]');
          if (lbl) {
            lbl.textContent = don.mode === 'pct' && don.pct
              ? `Spende an KKAD – ${don.pct} %`
              : 'Spende an KKAD';
          }
          const amt = donLine.querySelector('[data-donation-line-amount]');
          if (amt) amt.textContent = fmt(donAmt);
        }
      }

      function addItem(data: Omit<CartItem, 'qty'>, qty = 1) {
        const items = read();
        const ex = items.find((i) => i.id === data.id);
        if (ex) ex.qty += qty; else items.push({ ...data, qty });
        write(items);
        render();
        showAddedToast(data.name);
      }
      function changeQty(id: string, delta: number) {
        let items = read();
        items = items
          .map((i) => (i.id === id ? { ...i, qty: i.qty + delta } : i))
          .filter((i) => i.qty > 0);
        write(items);
        render();
      }
      function removeItem(id: string) {
        write(read().filter((i) => i.id !== id));
        render();
      }
      // Kurzes Feedback nach "In den Warenkorb" mit Link zur Warenkorb-Seite
      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      function showAddedToast(name: string) {
        const toast = document.querySelector('[data-added-toast]') as HTMLElement | null;
        if (!toast) return;
        const nameEl = toast.querySelector('[data-added-name]');
        if (nameEl) nameEl.textContent = name;
        toast.hidden = false;
        requestAnimationFrame(() => toast.classList.add('is-visible'));
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('is-visible');
          setTimeout(() => { toast.hidden = true; }, 350);
        }, 4000);
      }

      // ---- Snipcart-Feinschliff ----
      // 1) Spendenzeile: Mengen-Stepper / "Anz: 125" / 0,01-€-Stückpreis verbergen
      //    (die Spende läuft technisch als 1-Cent-Positionen, Kunden sehen nur den Betrag)
      // 2) Bestellbestätigung: großer "Zurück zum Shop"-Button
      const tidySnipcart = () => {
        const root = document.getElementById('snipcart');
        if (!root || !root.children.length) return;
        root.querySelectorAll('[class*="item-line"]').forEach((line) => {
          if (!line.textContent || !line.textContent.includes('Spende an KKAD')) return;
          // Spendenzeilen strukturell markieren – nur INNERHALB dieser Zeilen
          // wird später das Mengen-Label ersetzt (nie auf Produktzeilen)
          line.setAttribute('data-butxi-don', '1');
          line.querySelectorAll('[class*="quantity"]').forEach((q) => { (q as HTMLElement).style.display = 'none'; });
          // Spende ans Ende der Artikelliste (direkt über der Gesamtsumme) verschieben —
          // nur das äußere Zeilen-Element, nicht dessen Kinder (item-line__…)
          const isTopLine = String(line.className).split(' ').some((c) => c.endsWith('item-line'));
          const list = line.parentElement;
          if (isTopLine && list && line !== list.lastElementChild) list.appendChild(line);
        });
        const donLabel = localStorage.getItem('butxi-don-label') || '';
        root.querySelectorAll('[data-butxi-don] span, [data-butxi-don] small, [data-butxi-don] p, [data-butxi-don] div').forEach((el) => {
          if (el.children.length > 0) return;
          const t = (el.textContent || '').trim();
          if (t === donLabel) return; // schon ersetzt
          const isQty = /^(Anz\.?|Anzahl|Qty)\s*:?\s*\d+$/.test(t) || /^x\s*\d+$/.test(t);
          if (isQty) {
            if (donLabel) el.textContent = donLabel; // "x32" -> "5 %"
            else (el as HTMLElement).style.visibility = 'hidden';
          } else if (t === '0,01 €') {
            (el as HTMLElement).style.visibility = 'hidden'; // 1-Cent-Stückpreis verbergen
          }
        });
        const thanks = [...root.querySelectorAll('h1, h2, [class*="thank"]')].find(
          (el) => el.textContent && el.textContent.includes('Vielen Dank')
        );
        if (thanks && !root.querySelector('[data-butxi-back]')) {
          const btn = document.createElement('button');
          btn.className = 'btn btn--primary btn--lg';
          btn.textContent = 'Zurück zum Shop';
          btn.setAttribute('data-butxi-back', '');
          btn.style.margin = '18px 0 4px';
          btn.addEventListener('click', () => {
            const w = window as any;
            try { w.Snipcart.api.theme.cart.close(); } catch {}
            location.hash = '';
          });
          thanks.parentElement?.appendChild(btn);
        }
      };
      new MutationObserver(() => requestAnimationFrame(tidySnipcart))
        .observe(document.body, { childList: true, subtree: true });

      // Nach erfolgreicher Bestellung: lokalen Warenkorb + Spendenwahl leeren
      document.addEventListener('snipcart.ready', () => {
        (window as any).Snipcart.events.on('cart.confirmed', () => {
          write([]);
          writeDon({ mode: 'none' });
          render();
        });
      });

      // Wire up
      document.querySelectorAll('[data-add-to-cart]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const el = btn as HTMLElement;
          const qtyInput = document.querySelector('[data-pdp-qty]') as HTMLElement | null;
          const qty = el.hasAttribute('data-use-pdp-qty') && qtyInput
            ? parseInt(qtyInput.textContent || '1', 10)
            : 1;
          addItem({
            id: el.dataset.id!,
            name: el.dataset.name!,
            price: parseFloat(el.dataset.price!),
            image: el.dataset.image!,
            meta: el.dataset.meta || '',
          }, qty);
        });
      });

      // ---- Spende an KKAD: Auswahl-Events ----
      document.querySelectorAll('[data-donate-pct]').forEach((btn) =>
        btn.addEventListener('click', () => {
          writeDon({ mode: 'pct', pct: Number((btn as HTMLElement).dataset.donatePct) });
          render();
        })
      );
      document.querySelector('[data-donate-none]')?.addEventListener('click', () => {
        writeDon({ mode: 'none' });
        render();
      });
      document.querySelector('[data-donate-remove]')?.addEventListener('click', () => {
        writeDon({ mode: 'none' });
        render();
      });
      document.querySelector('[data-donate-custom-add]')?.addEventListener('click', () => {
        const input = document.querySelector('[data-donate-custom-input]') as HTMLInputElement | null;
        const val = parseFloat((input?.value || '').replace(',', '.'));
        if (!isNaN(val) && val > 0) {
          writeDon({ mode: 'custom', amount: Math.round(val * 100) / 100 });
          if (input) input.value = '';
          render();
        }
      });

      // Checkout: hand off to Snipcart when configured
      const checkoutBtn = document.querySelector('[data-checkout]') as HTMLButtonElement | null;
      checkoutBtn?.addEventListener('click', async () => {
        const w = window as any;
        if (checkoutBtn.dataset.snipcartKey && w.Snipcart) {
          const items = read();
          try {
            // Erst vorhandene Snipcart-Positionen leeren – sonst addieren sich
            // wiederholte Checkout-Klicks zu doppelten Warenkörben
            const existing = w.Snipcart.store.getState().cart.items.items || [];
            for (const ex of existing) {
              await w.Snipcart.api.cart.items.remove(ex.uniqueId);
            }
            await w.Snipcart.api.cart.items.add(...items.map((i) => ({
              id: i.id, name: i.name, price: i.price, quantity: i.qty,
              url: '/product/' + i.id + '/', image: i.image,
            })));
            // Spende an KKAD als 1-Cent-Positionen (Menge = Betrag in Cent),
            // damit Snipcarts Preisvalidierung greift
            const donAmt = donationAmount(items.reduce((s, i) => s + i.price * i.qty, 0));
            const dNow = readDon();
            localStorage.setItem('butxi-don-label', dNow.mode === 'pct' && dNow.pct ? dNow.pct + ' %' : '');
            if (donAmt > 0) {
              await w.Snipcart.api.cart.items.add({
                id: 'spende-kkad',
                name: 'Spende an KKAD',
                price: 0.01,
                quantity: Math.round(donAmt * 100),
                url: '/',
                shippable: false,
                taxable: false,
              });
            }
            w.Snipcart.api.theme.cart.open();
          } catch (err) { console.error('Snipcart error', err); }
        } else {
          const note = document.querySelector('[data-checkout-note]');
          if (note) note.textContent = 'Checkout folgt: Snipcart-API-Key in .env hinterlegen (PUBLIC_SNIPCART_API_KEY).';
        }
      });

      // PDP quantity stepper
      document.querySelectorAll('[data-pdp-stepper]').forEach((st) => {
        const val = st.querySelector('[data-pdp-qty]') as HTMLElement;
        st.querySelector('[data-pdp-plus]')?.addEventListener('click', () => {
          val.textContent = String(Math.min(10, parseInt(val.textContent || '1', 10) + 1));
        });
        st.querySelector('[data-pdp-minus]')?.addEventListener('click', () => {
          val.textContent = String(Math.max(1, parseInt(val.textContent || '1', 10) - 1));
        });
      });

      // Scroll reveals
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      render();
    </script>
  </body>
</html>
