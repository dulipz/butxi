---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';

const principles = [
  {
    icon: 'leaf', title: 'Eigenanbau',
    text: 'Viele unserer Chilis und Kräuter bauen wir vor Ort selbst an, für maximale Frische, klare Herkunft und intensives Aroma in jeder Flasche.',
  },
  {
    icon: 'heart', title: 'Manufaktur',
    text: 'Unsere Soßen entstehen in kleinen Chargen statt Massenproduktion, mit Handarbeit vom Schneiden bis zur Abfüllung.',
  },
  {
    icon: 'clock', title: 'Zeit & Reife',
    text: 'Durch sorgfältige Verarbeitung und ausgewählte Reifeprozesse wie Fermentation entsteht Tiefe, Schärfe mit Charakter statt bloßem Brennen.',
  },
  {
    icon: 'check', title: 'Qualitätskontrolle',
    text: 'Kontrolle vom Feld bis zur Flasche: Rohstoffe, Geschmack, Schärfe und Konsistenz, jede Charge muss unseren Ansprüchen genügen.',
  },
];
---
<BaseLayout
  title="Produktion · BUTXI Gourmet"
  description="Handwerk, Zeit und Feuer: Wie BUTXI Hot Sauces und Gourmet-Salze im Eigenanbau und in der Manufaktur entstehen."
  transparentHeader
>
  <!-- Fullscreen-Hero, gleiche Mechanik wie auf der Startseite -->
  <section class="hero">
    <picture>
      <source media="(max-width: 767px)" srcset="/images/hero/hero-produktion-mobile-001.webp" />
      <img
        class="hero__bg"
        src="/images/hero/hero-produktion-001.webp"
        alt="Die BUTXI Finca aus der Luft: Steinhäuser, Innenhof und Olivenhaine vor der Serra de Tramuntana"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__content">
      <div class="hero__copy">
        <span class="badge badge--olive hero__badge-top">Produktion · Eigenanbau</span>
        <h1 class="hero__title display-xl">
          <span>Handwerk, Zeit und</span>
          <span class="hero__title-accent">Feuer</span>
        </h1>
      </div>
      <div class="hero__bottom">
        <p class="lead">
          <span class="hero__lead-full">Wir kochen, fermentieren und verfeinern unsere Hot Sauce selbst, statt auf Massenware zu setzen.</span>
          <span class="hero__lead-short">Selbst gekocht und fermentiert, keine Massenware.</span>
        </p>
        <div class="hero__actions">
          <a href="#prinzipien" class="btn btn--primary btn--lg">Unsere Prinzipien</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="prinzipien">
    <div class="container">
      <SectionHeader eyebrow="Unsere Produktion" title="Vier Prinzipien, eine Handschrift" />
      <div class="principles">
        {principles.map((p, i) => (
          <div class="principle card">
            <span class="principle__num">0{i + 1}</span>
            <span class="principle__icon"><Icon name={p.icon} size={22} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section--dark section">
    <div class="container anbau">
      <img src="/images/anbau/anbau_gewaechshaus_001.webp" alt="Chilipflanzen im BUTXI Gewächshaus auf Mallorca" loading="lazy" />
      <div class="anbau__copy">
        <span class="eyebrow">Vom Feld in die Flasche</span>
        <h2>Geerntet nach Reife, nicht nach Kalender</h2>
        <p>
          Unsere Chilis wachsen, bis Reife, Aroma und Schärfe exakt unseren Ansprüchen
          entsprechen, erst dann wird geerntet. So stimmt die Qualität von Anfang an,
          lange bevor die erste Flasche gefüllt ist.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container salz">
      <div class="salz__copy">
        <SectionHeader
          eyebrow="Salzproduktion"
          title="Das Finish, das man sieht und schmeckt"
          text="Mallorquinische Salzflocken, verarbeitet mit charakterstarken Blends aus eigenem Anbau, als Finish, das Gerichte sichtbar und schmeckbar aufwertet."
        />
        <a href="/shop/" class="btn btn--secondary">Salze entdecken</a>
      </div>
      <img src="/images/products/product_001.webp" alt="BUTXI Produkte" loading="lazy" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Fullscreen-Hero: liegt unter dem transparenten Header (76px hochgezogen). */
  .hero {
    position: relative;
    margin-top: -77px; /* 76px Header + 1px Border, sonst blitzt oben eine weiße Linie auf */
    min-height: calc(100svh + 1px);
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero__overlay {
    position: absolute; inset: 0;
    background:
      /* unten kräftiger als auf der Startseite: der Vordergrund dieses Motivs ist hell */
      linear-gradient(to bottom, rgba(20, 14, 8, 0.30) 0%, rgba(20, 14, 8, 0) 30%, rgba(20, 14, 8, 0.10) 58%, rgba(20, 14, 8, 0.62) 100%),
      linear-gradient(to right, rgba(20, 14, 8, 0.42) 0%, rgba(20, 14, 8, 0.12) 40%, rgba(20, 14, 8, 0) 65%);
  }
  .hero__content {
    position: relative; z-index: 1; width: 100%;
    display: flex; flex-direction: column; justify-content: space-between;
    padding-top: calc(76px + 36px);
    padding-bottom: 44px;
  }
  .hero__copy .badge, .hero__bottom .badge { font-size: 19px; padding: 5px 18px; }
  .hero__copy {
    display: flex; flex-direction: column; gap: 16px;
    align-items: center; width: fit-content;
  }
  .hero__title {
    display: flex; flex-direction: column; align-items: center;
    text-align: center; line-height: 1.08;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
    font-size: clamp(1.75rem, 3.5vw, 3.25rem);
  }
  .hero__title-accent {
    font-size: 1.3em;
    color: var(--color-action-primary);
  }
  .hero__bottom {
    display: flex; flex-direction: column; gap: 20px;
    align-items: center; align-self: center; text-align: center;
    max-width: 640px;
  }
  .hero__bottom .lead {
    margin: 0; font-size: 19px; color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .hero__lead-short { display: none; }

  @media (max-width: 767px) {
    .hero__copy .badge { display: none; }
    .hero__title { margin-top: 14px; }
    .hero__lead-full { display: none; }
    .hero__lead-short { display: inline; }
    .hero__content { padding-top: calc(76px + 4px); }
    .hero__copy {
      align-self: flex-start;
      width: 100%;
      align-items: flex-start;
      text-align: left;
    }
    .hero__title { align-items: flex-start; text-align: left; font-size: clamp(1.7rem, 7.65vw, 2.21rem); }
  }
  @media (max-width: 1023px) {
    .hero__content { padding-bottom: 48px; }
  }

  .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; }
  .principle { padding: 28px; display: flex; flex-direction: column; gap: 10px; position: relative; }
  .principle__num {
    position: absolute; top: 22px; right: 26px;
    font-family: var(--font-display); font-size: 28px; font-weight: 600;
    color: var(--color-neutral-200);
  }
  .principle__icon {
    display: grid; place-items: center; width: 48px; height: 48px;
    border-radius: var(--radius-md); background: var(--color-mallorca-sand);
    color: var(--color-deep-brown); margin-bottom: 4px;
  }
  .principle p { margin: 0; color: var(--color-text-secondary); }

  .anbau, .salz { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .anbau img, .salz img {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-xl);
  }
  .anbau__copy, .salz__copy { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .anbau__copy h2 { color: var(--color-text-inverse); }
  .anbau__copy p { margin: 0; color: var(--color-text-inverse-secondary); line-height: 1.75; }

  @media (max-width: 1023px) {
    .principles { grid-template-columns: 1fr; }
    .anbau, .salz { grid-template-columns: 1fr; }
    .salz img { order: -1; }
  }
</style>
