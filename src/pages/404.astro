---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Seite nicht gefunden · BUTXI Gourmet">
  <section class="section--editorial section">
    <div class="container wrap">
      <span class="eyebrow">404</span>
      <h1>Hier brennt nichts</h1>
      <p class="lead">Diese Seite gibt es nicht, aber das Feuer wartet im Shop.</p>
      <a href="/shop/" class="btn btn--primary btn--lg">Zum Shop</a>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap { display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center; }
  .wrap p { margin: 0; }
</style>
