---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Kontakt — BUTXI Gourmet" description="Fragen zu Saucen, Gewürzen oder Ölen? Kontaktiere BUTXI Gourmet — wir helfen gern weiter.">
  <section class="section">
    <div class="container grid">
      <div class="info">
        <span class="eyebrow">Kontakt</span>
        <h1>Sag uns, was brennt</h1>
        <p class="lead">
          Fragen zu Zutaten, Herkunft, Verarbeitung oder Sorten?
          Wir helfen gern weiter — schnell und unkompliziert.
        </p>
        <div class="channels">
          <a href="tel:+4933413088288" class="channel">
            <span class="channel__icon"><Icon name="phone" size={20} /></span>
            <span>
              <strong>Telefon</strong>
              03341 / 3088288
            </span>
          </a>
          <a href="mailto:info@butxigourmet.com" class="channel">
            <span class="channel__icon"><Icon name="mail" size={20} /></span>
            <span>
              <strong>E-Mail</strong>
              info@butxigourmet.com
            </span>
          </a>
          <a href="mailto:sales@butxigourmet.com" class="channel">
            <span class="channel__icon"><Icon name="bag" size={20} /></span>
            <span>
              <strong>Handel &amp; Gastronomie</strong>
              sales@butxigourmet.com
            </span>
          </a>
        </div>
      </div>

      <form class="form card" data-contact-form>
        <div class="form__row">
          <div class="field">
            <label for="c-name">Vorname *</label>
            <input class="input" id="c-name" name="name" type="text" required />
          </div>
          <div class="field">
            <label for="c-email">E-Mail-Adresse *</label>
            <input class="input" id="c-email" name="email" type="email" required />
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="c-subject">Anliegen *</label>
            <input class="input" id="c-subject" name="subject" type="text" required />
          </div>
          <div class="field">
            <label for="c-phone">Telefonnummer</label>
            <input class="input" id="c-phone" name="phone" type="tel" />
          </div>
        </div>
        <div class="field">
          <label for="c-message">Nachricht *</label>
          <textarea class="input input--area" id="c-message" name="message" maxlength="1000" required></textarea>
        </div>
        <button class="btn btn--primary btn--lg" type="submit">Nachricht senden</button>
        <p class="form__success" data-contact-success hidden>
          Danke! Deine Nachricht ist unterwegs — wir melden uns so schnell wie möglich.
        </p>
        <p class="form__note">* Pflichtfelder. Deine Daten werden nur zur Bearbeitung deiner Anfrage verwendet.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: start; }
  .info { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .info p { margin: 0; }
  .channels { display: flex; flex-direction: column; gap: 14px; margin-top: 20px; width: 100%; }
  .channel {
    display: flex; gap: 14px; align-items: center;
    padding: 14px 18px; border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg); background: var(--color-background-secondary);
    transition: box-shadow var(--duration-default) var(--ease-standard);
  }
  .channel:hover { box-shadow: var(--shadow-md); }
  .channel__icon {
    display: grid; place-items: center; width: 44px; height: 44px; flex: none;
    border-radius: var(--radius-md); background: var(--color-mallorca-sand);
    color: var(--color-deep-brown);
  }
  .channel strong { display: block; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }

  .form { padding: 32px; display: flex; flex-direction: column; gap: 18px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form__success { margin: 0; font-weight: 700; color: var(--color-success); }
  .form__note { margin: 0; font-size: 12.5px; color: var(--color-text-muted); }

  @media (max-width: 1023px) {
    .grid { grid-template-columns: 1fr; gap: 40px; }
    .form__row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // TODO: An Form-Backend anbinden (z. B. Cloudflare Worker, Formspree oder Web3Forms)
    const success = form.querySelector('[data-contact-success]') as HTMLElement | null;
    if (success) success.hidden = false;
    form.reset();
  });
</script>
