---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import Lightbox from '../components/Lightbox.astro';
import { recipes, recipeCategories } from '../data/recipes';
---
<BaseLayout
  title="Rezepte · BUTXI Gourmet"
  description="BUTXI Rezepte mit Hot Sauce, Chili-Ölen und Gourmet-Salzen: gesund kochen, intensiver schmecken."
  transparentHeader
>
  <!-- Fullscreen-Hero, gleiche Mechanik wie auf der Startseite -->
  <section class="hero">
    <picture>
      <source media="(max-width: 767px)" srcset="/images/hero/hero-rezepte-mobile-001.webp" />
      <img
        class="hero__bg"
        src="/images/hero/hero-rezepte-001.webp"
        alt="Gedeckter Tisch unter der Pergola mit BUTXI Saucen, Salzen und einer Schale Escalivada, im Hintergrund eine Bucht auf Mallorca"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__content">
      <div class="hero__copy">
        <span class="badge badge--olive hero__badge-top">Rezepte · Mallorca</span>
        <h1 class="hero__title display-xl">
          <span>Gesund kochen,</span>
          <span class="hero__title-accent">intensiver</span>
          <span>schmecken</span>
        </h1>
      </div>
      <div class="hero__bottom">
        <p class="lead">
          <span class="hero__lead-full">BUTXI Rezepte mit Hot Sauce, Chili-Ölen und Gourmet-Salzen.</span>
          <span class="hero__lead-short">Rezepte mit Hot Sauce, Öl und Salz.</span>
        </p>
        <div class="hero__actions">
          <a href="#rezepte" class="btn btn--primary btn--lg">Zu den Rezepten</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="rezepte" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="filters" data-filters>
        {recipeCategories.map((c, i) => (
          <button class:list={['filter', { 'is-active': i === 0 }]} data-filter={c}>{c}</button>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0.5rem;">
    <div class="container">
      <div class="grid" data-recipe-grid>
        {recipes.map((r) => <RecipeCard recipe={r} />)}
        <div class="teaser">
          <p>Jeden Monat neue Rezepte,<br />bleib über den Newsletter dran.</p>
        </div>
      </div>
    </div>
  </section>
  <Lightbox />
</BaseLayout>

<style>
  /* Fullscreen-Hero: liegt unter dem transparenten Header (76px hochgezogen). */
  .hero {
    position: relative;
    margin-top: -77px; /* 76px Header + 1px Border, sonst blitzt oben eine weiße Linie auf */
    min-height: calc(100svh + 1px);
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero__overlay {
    position: absolute; inset: 0;
    background:
      /* unten kräftiger als auf der Startseite: der Vordergrund dieses Motivs ist hell */
      linear-gradient(to bottom, rgba(20, 14, 8, 0.30) 0%, rgba(20, 14, 8, 0) 30%, rgba(20, 14, 8, 0.10) 58%, rgba(20, 14, 8, 0.62) 100%),
      linear-gradient(to right, rgba(20, 14, 8, 0.42) 0%, rgba(20, 14, 8, 0.12) 40%, rgba(20, 14, 8, 0) 65%);
  }
  .hero__content {
    position: relative; z-index: 1; width: 100%;
    display: flex; flex-direction: column; justify-content: space-between;
    padding-top: calc(76px + 36px);
    padding-bottom: 44px;
  }
  .hero__copy .badge, .hero__bottom .badge { font-size: 19px; padding: 5px 18px; }
  .hero__copy {
    display: flex; flex-direction: column; gap: 16px;
    align-items: center; width: fit-content;
  }
  .hero__title {
    display: flex; flex-direction: column; align-items: center;
    text-align: center; line-height: 1.08;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
    font-size: clamp(1.75rem, 3.5vw, 3.25rem);
  }
  .hero__title-accent {
    font-size: 1.3em;
    color: var(--color-action-primary);
  }
  .hero__bottom {
    display: flex; flex-direction: column; gap: 20px;
    align-items: center; align-self: center; text-align: center;
    max-width: 640px;
  }
  .hero__bottom .lead {
    margin: 0; font-size: 19px; color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .hero__lead-short { display: none; }

  @media (max-width: 767px) {
    .hero__copy .badge { display: none; }
    .hero__title { margin-top: 14px; }
    .hero__lead-full { display: none; }
    .hero__lead-short { display: inline; }
    .hero__content { padding-top: calc(76px + 4px); }
    .hero__copy {
      align-self: flex-start;
      width: 100%;
      align-items: flex-start;
      text-align: left;
    }
    .hero__title { align-items: flex-start; text-align: left; font-size: clamp(1.7rem, 7.65vw, 2.21rem); }
  }
  @media (max-width: 1023px) {
    .hero__content { padding-bottom: 48px; }
  }

  .filters { display: flex; gap: 10px; flex-wrap: wrap; }
  .filter {
    font-family: var(--font-sans); font-size: 14px; font-weight: 700;
    padding: 8px 18px; border-radius: 999px; cursor: pointer;
    border: 1.5px solid var(--color-border-default);
    background: var(--color-background-secondary);
    color: var(--color-text-primary);
    transition: all var(--duration-fast) var(--ease-standard);
  }
  .filter:hover { border-color: var(--color-border-strong); }
  .filter.is-active {
    border-color: var(--color-neutral-950);
    background: var(--color-neutral-950);
    color: var(--color-text-inverse);
  }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .teaser {
    border: 1.5px dashed var(--color-border-strong); border-radius: var(--radius-lg);
    display: grid; place-items: center; padding: 24px; min-height: 260px;
  }
  .teaser p { margin: 0; font-size: 14.5px; color: var(--color-text-muted); text-align: center; }
  @media (max-width: 1023px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 639px)  { .grid { grid-template-columns: 1fr; } }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-recipe-grid] [data-category]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
      const cat = btn.dataset.filter;
      cards.forEach((card) => {
        card.style.display = cat === 'Alle' || card.dataset.category === cat ? '' : 'none';
      });
    });
  });
</script>
